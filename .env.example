# 32-byte hex key for AES-256-GCM credential encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Helios API key (used when connecting via Helios)
HELIOS_API_KEY=your_helios_api_key_here

# Dashboard API key — set a strong random value (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
DASHBOARD_API_KEY=your_dashboard_api_key_here

PORT=3001

# AI-powered insights via GitHub Models (OpenAI-compatible, authenticated with a
# GitHub Personal Access Token). Create a fine-grained PAT with the "Models"
# permission at https://github.com/settings/personal-access-tokens
# Leave GITHUB_MODELS_TOKEN unset to disable the "Analyze with AI" feature.
GITHUB_MODELS_TOKEN=
# Optional overrides (defaults shown):
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
# GITHUB_MODELS_MODEL=openai/gpt-5-mini
# Hours before a cached AI analysis is flagged stale (default 24):
# LLM_ANALYSIS_TTL_HOURS=24
# Free-text operator context describing what is NORMAL for your estate, so the AI
# doesn't flag expected patterns. Example below — edit to match your environment:
# LLM_ESTATE_CONTEXT=Clusters tagged "target" or "archive" are replication/archive targets where thousands of unprotected sources are expected and not a risk. Source objects are typically protected on their primary cluster, not here.

