# Companion unit to cohesity-dashboard.service — runs the background pollers.
# Since the 2026-07-14 two-process split, server.js starts NO pollers; without
# this unit (or RUN_POLLERS_INLINE=true) nothing collects data and every
# platform goes stale.
#
# Install:
#   sudo cp deploy/cohesity-poller.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cohesity-poller
#
# Adjust WorkingDirectory/ExecStart/User to match cohesity-dashboard.service
# on this box. The poller reads the same .env (loaded by the app itself from
# the WorkingDirectory) and shares the SQLite DB via WAL.

[Unit]
Description=Cohesity Dashboard — background pollers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cohesity-dashboard
ExecStart=/usr/bin/node backend/pollerProcess.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Hardening. Run this unit as the same unprivileged user as
# cohesity-dashboard.service (add a User= line; without one systemd runs it
# as root). Directives an older systemd does not know are ignored with a
# warning, they do not stop the unit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/cohesity-dashboard
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
