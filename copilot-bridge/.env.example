# Host/port the local bridge listens on. Keep it on 127.0.0.1 unless you know what you are doing.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# HTTPS listener (LAN-accessible). A self-signed cert is generated automatically on first
# start (stored in .bridge/tls/). Set HTTPS_ENABLE=false to run HTTP-only.
HTTPS_ENABLE=true
HTTPS_HOST=0.0.0.0
HTTPS_PORT=443
# Optional: supply your own cert instead of the auto self-signed one.
# TLS_CERT_PATH=
# TLS_KEY_PATH=
# TLS_PFX_PATH=
# TLS_PFX_PASS=

# Default model. 'auto' picks the newest Claude Sonnet available on your Copilot plan.
# You can also hard-code an ID like: claude-sonnet-4.5, claude-sonnet-4, claude-3.5-sonnet, gpt-4o
DEFAULT_MODEL=auto

# How many recent messages to retain per conversation (system message is always kept).
MAX_HISTORY_MESSAGES=40

# Optional: skip the interactive `npm run login` by supplying a GitHub token directly.
# GITHUB_TOKEN=

# Advanced (rarely need changing) ---------------------------------------------
# GITHUB_CLIENT_ID=Iv1.b507a08c87ecfe98
# COPILOT_API_BASE=https://api.githubcopilot.com
# EDITOR_VERSION=vscode/1.95.0
# EDITOR_PLUGIN_VERSION=copilot-chat/0.23.0
# USER_AGENT=GitHubCopilotChat/0.23.0
