# 32-byte hex key for AES-256-GCM credential encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Helios API key (used when connecting via Helios)
HELIOS_API_KEY=your_helios_api_key_here

# Dashboard API key — set a strong random value (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
DASHBOARD_API_KEY=your_dashboard_api_key_here

# ── Product license ──────────────────────────────────────────────────────────
# License key issued by the vendor (CDBL-...). The dashboard is locked without
# a valid key. Keys are valid for 1 year; renewals are picked up automatically
# from the renewal endpoint (or paste the emailed extension certificate on the
# license page for air-gapped installs).
LICENSE_KEY=
# Vendor renewal endpoint (optional override):
# LICENSE_RENEWAL_URL=https://licensing.example.com

# ── AI alert review (optional) ───────────────────────────────────────────────
# GitHub token with access to GitHub Models (https://github.com/marketplace/models).
# Leave blank to disable the AI Review feature entirely.
GITHUB_MODELS_TOKEN=

# Model id. Default is a cheap, known-good GitHub Models option.
# NOTE: the GitHub Models catalog does not currently host Anthropic Claude
# (Haiku). To use Haiku, point AI_BASE_URL/AI_MODEL at a provider that serves it.
AI_MODEL=openai/gpt-4o-mini

# OpenAI-compatible chat-completions base URL (default: GitHub Models).
AI_BASE_URL=https://models.github.ai/inference

PORT=3001

# AI-powered insights via GitHub Models (OpenAI-compatible, authenticated with a
# GitHub Personal Access Token). Create a fine-grained PAT with the "Models"
# permission at https://github.com/settings/personal-access-tokens
# Leave GITHUB_MODELS_TOKEN unset to disable the "Analyze with AI" feature.
GITHUB_MODELS_TOKEN=
# Optional overrides (defaults shown):
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
#
# To use the OpenAI API instead (pay-per-use, no GitHub free-tier daily cap):
# set OPENAI_TOKEN and it takes precedence over GitHub Models for the cluster
# analysis. Default model is gpt-5.4; override with OPENAI_MODEL.
# OPENAI_TOKEN=sk-...
# OPENAI_MODEL=gpt-5.4
# OPENAI_BASE_URL=https://api.openai.com/v1
# Hours before a cached AI analysis is flagged stale (default 24):
# LLM_ANALYSIS_TTL_HOURS=24
# Free-text operator context describing what is NORMAL for your estate, so the AI
# doesn't flag expected patterns. Example below — edit to match your environment:
# LLM_ESTATE_CONTEXT=Clusters tagged "target" or "archive" are replication/archive targets where thousands of unprotected sources are expected and not a risk. Source objects are typically protected on their primary cluster, not here.

